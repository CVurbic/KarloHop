# Google Maps / Places API
# Treba uključen "Places API (New)" — adresno polje u rezervaciji (autocomplete + koordinate).
# Postavljanje ključa korak po korak: docs/google-places-setup.md
VITE_GOOGLE_MAPS_API_KEY="tvoj-google-maps-api-key"
# Place ID vaše lokacije na Google Maps -> potreban za dohvat pravih recenzija.
# Pronađi ga: https://developers.google.com/maps/documentation/places/web-service/place-id
# (upiši ime tvrtke u "Find the ID of a place"). Bez njega prikazuju se rezervne recenzije.
VITE_GOOGLE_PLACE_ID="tvoj-place-id"

# Supabase projekt
VITE_SUPABASE_URL="https://tvoj-projekt.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="tvoj-anon-key"

# Service role key — potreban SAMO za setup skriptu (npm run setup:db)
# Pronađi ga u: Supabase dashboard -> Settings -> API -> service_role key
# NIKAD ne commitaj pravi key u git!
SUPABASE_SERVICE_ROLE_KEY="tvoj-service-role-key"
